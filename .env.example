# Copy to .env.local and fill in real values. NEVER commit .env.local.
# This file documents variable NAMES only — placeholders, no secrets.

# --- NextAuth ---
NEXTAUTH_SECRET=generate-with-`openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000

# --- Sanity (public ids) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=x37u2l54
NEXT_PUBLIC_SANITY_DATASET=production

# --- Sanity tokens ---
# Read-only viewer token: preferred for all server-side reads.
SANITY_READ_TOKEN=
# Write-capable token: used only for mutations (e.g. job applications).
SANITY_API_TOKEN=

# --- Google Analytics 4 (Data API) ---
# JSON string of a service-account key: {"client_email":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT_KEY=
GA4_PROPERTY_ID=

# --- Mapbox (browser) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Site URL (canonical, sitemap, OG tags) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
